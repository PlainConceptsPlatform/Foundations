{
  "name": "platform-foundations",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Platform foundation for PlainConcepts Platform apps: theme, conventions, docs, and a themed component showcase.",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @plainconceptsplatform/docs dev",
    "build": "pnpm -r build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "publish:theme": "pnpm --filter @plainconceptsplatform/ui-theme publish --access public",
    "publish:ui-components": "pnpm --filter @plainconceptsplatform/ui-components build && pnpm --filter @plainconceptsplatform/ui-components publish --access public",
    "publish": "pnpm --filter @plainconceptsplatform/ui-components build && pnpm publish:theme && pnpm publish:ui-components",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{css,js,json,jsx,mjs,ts,tsx}": "biome check --write"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.48.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@vitest/coverage-v8": "^2.1.9",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^17.2.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
