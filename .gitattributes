# Normalize text files to LF in the repository, regardless of a contributor's
# core.autocrlf setting. Without this, a Windows checkout produces CRLF working
# copies that fail Biome's formatter (which expects LF), so `pnpm lint` fails
# locally while CI on Linux passes.
* text=auto eol=lf

# Binary files must never be line-ending converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary

# Generated; keep out of diffs and language stats.
pnpm-lock.yaml linguist-generated=true -diff
