{
  "name": "@plainconceptsplatform/ui-components",
  "version": "1.2.0",
  "description": "Shared React components for Platform frontend apps (Plain logo and more).",
  "type": "module",
  "license": "MIT",
  "files": ["src", "dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./plain-logo": {
      "types": "./dist/plain-logo/plain-logo.d.ts",
      "import": "./dist/plain-logo/plain-logo.js",
      "default": "./src/plain-logo/plain-logo.tsx"
    },
    "./data-table": {
      "types": "./dist/data-table/data-table.d.ts",
      "import": "./dist/data-table/data-table.js",
      "default": "./src/data-table/data-table.tsx"
    },
    "./changelog": {
      "types": "./dist/changelog/changelog.d.ts",
      "import": "./dist/changelog/changelog.js",
      "default": "./src/changelog/changelog.tsx"
    },
    "./app-sidebar": {
      "types": "./dist/app-sidebar/index.d.ts",
      "import": "./dist/app-sidebar/index.js",
      "default": "./src/app-sidebar/index.ts"
    }
  },
  "sideEffects": ["**/*.css", "**/*.ts", "**/*.tsx"],
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "@plainconceptsplatform/ui-theme": "workspace:*"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.3"
  },
  "scripts": {
    "build": "tsc --build --force",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "tsc --build --force"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PlainConceptsPlatform/Foundations.git",
    "directory": "packages/ui-components"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
