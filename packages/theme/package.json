{
  "name": "@plainconceptsplatform/ui-theme",
  "version": "0.1.0",
  "description": "Shared design tokens and theme (Platform styleguide) for Platform frontend apps. For shadcn/ui + Tailwind v4.",
  "type": "module",
  "license": "MIT",
  "files": ["src", "components.json", "bin"],
  "exports": {
    ".": "./src/index.css",
    "./theme.css": "./src/theme.css",
    "./base.css": "./src/base.css",
    "./components.json": "./components.json"
  },
  "bin": {
    "platform-init": "./bin/init.mjs"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "scripts": {
    "typecheck": "echo \"no types in theme package\" && exit 0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PlainConceptsPlatform/Foundations.git",
    "directory": "packages/theme"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
